; English.nsh: every user-visible string of the installer and the uninstaller (docs/m2/06-windows-release.md §6.10).
; Another language is one more file like this one. UTF-8; included with !include /CHARSET=UTF8 after MUI_LANGUAGE.
; Only LangString lines belong here (tools/desktoppkg check), and every one of them is used.

LangString Branding ${LANG_ENGLISH} "isshoni ${VERSION}"
LangString AnotherSetupRunning ${LANG_ENGLISH} "Another isshoni setup is running. Wait for it to finish, then try again."
LangString UpdatingBanner ${LANG_ENGLISH} "Updating isshoni to ${VERSION}…"
LangString AppRunning ${LANG_ENGLISH} "isshoni is running. Quit it from the tray icon, then click Retry."
LangString UnsupportedWindows ${LANG_ENGLISH} "isshoni needs 64-bit Windows 10 22H2 or later."
LangString NewerInstalled ${LANG_ENGLISH} "A newer version of isshoni ($OldVersion) is installed. To install ${VERSION} over it anyway, run this setup with /ALLOWDOWNGRADE."
LangString WriteFailed ${LANG_ENGLISH} "A file could not be written to $INSTDIR. Quit isshoni and any program that uses its files, then run this setup again."
LangString RegistryFailed ${LANG_ENGLISH} "The settings of isshoni could not be written to the registry."
LangString WebView2Installing ${LANG_ENGLISH} "Installing the Microsoft Edge WebView2 Runtime, which isshoni needs…"
LangString WebView2Missing ${LANG_ENGLISH} "isshoni needs the Microsoft Edge WebView2 Runtime 120 or later, and it could not be installed. Open Microsoft's download page now?"
LangString ServerIgnored ${LANG_ENGLISH} "The server address given with /SERVER= was ignored: it must be an https:// address, or an http:// address on this PC."
LangString ShortcutIdFailed ${LANG_ENGLISH} "The notification id of a shortcut could not be set; the app works, but its notifications may not group with it."
LangString WelcomeTitle ${LANG_ENGLISH} "Welcome to isshoni"
LangString WelcomeText ${LANG_ENGLISH} "isshoni shares your screen and sound with friends, without your voice apps.$\r$\n$\r$\nNeeds Windows 10 22H2 or later.$\r$\n$\r$\nClick Next to continue."
LangString WelcomeLink ${LANG_ENGLISH} "moonwx.github.io/isshoni/download"
LangString CompatTitle ${LANG_ENGLISH} "Before you install"
LangString CompatSubtitle ${LANG_ENGLISH} "isshoni may not work as expected on this PC."
LangString OldBuildWarning ${LANG_ENGLISH} "Windows 10 22H2 or later is supported; this may work."
LangString Arm64Warning ${LANG_ENGLISH} "This PC has an ARM processor: the x64 app runs under emulation, which is not tested."
LangString OptionsTitle ${LANG_ENGLISH} "Options"
LangString OptionsSubtitle ${LANG_ENGLISH} "Choose how isshoni is set up."
LangString OptionDesktopShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString OptionUpdateChecks ${LANG_ENGLISH} "Check for updates automatically (asks GitHub once a day; see the privacy page)"
LangString OptionPrivacyLink ${LANG_ENGLISH} "Privacy page"
LangString FinishRun ${LANG_ENGLISH} "Start isshoni"
LangString FinishInstalled ${LANG_ENGLISH} "isshoni ${VERSION} is installed."
LangString FinishNext ${LANG_ENGLISH} "Next: go back to your browser and click Open isshoni"
LangString UnConfirmTitle ${LANG_ENGLISH} "Uninstall isshoni"
LangString UnConfirmSubtitle ${LANG_ENGLISH} "Remove isshoni from this PC."
LangString UnConfirmText ${LANG_ENGLISH} "isshoni will be removed from $INSTDIR. Its sign-ins on this PC, the linked devices and their saved credentials, are removed too."
LangString UnPurgeOption ${LANG_ENGLISH} "Also remove my settings and logs on this PC"
LangString UnForgetting ${LANG_ENGLISH} "Removing the sign-ins of isshoni…"
LangString UnDataRootKept ${LANG_ENGLISH} "The settings folder $LOCALAPPDATA\isshoni overlaps the install folder $INSTDIR, so it is not removed; delete what you no longer need yourself."
LangString UnForgetFailed ${LANG_ENGLISH} "Not every sign-in of isshoni could be removed ($R1); the uninstall goes on."
LangString RestoreFailed ${LANG_ENGLISH} "$INSTDIR\$Line could not be put back from $Line.old."
LangString StaleSkipped ${LANG_ENGLISH} "The previous install-files.txt names $Line, which is not inside the install folder; skipped."
