# A systemd container of one supported distro, for the install.sh scenarios of deploy/test/distro-test.sh
# (docs/m1/06-deploy-and-ci.md §4.13, §11.2).
#
#   docker build -t isshoni-distro-test:debian-12 --build-arg BASE=debian:12 -f deploy/test/distro/Containerfile deploy/test/distro
#
# It has what a small server has and the tests use: systemd as PID 1, D-Bus, curl with the CA certificates,
# iproute2 (ss, for the installer's port check), procps and python3 (the tests' own helpers). The OpenSSH client
# is left out on purpose: the installer has to install it itself to verify the release signature. So are the
# package lists, as in a fresh image.
ARG BASE=debian:12
FROM ${BASE}

RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus curl ca-certificates iproute2 procps python3 \
      && rm -rf /var/lib/apt/lists/*; \
    else \
      dnf install -y systemd dbus-broker curl ca-certificates iproute procps-ng python3 \
      && dnf clean all; \
    fi

# systemd stops cleanly on SIGRTMIN+3; the engine's default SIGTERM makes it re-execute itself.
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
