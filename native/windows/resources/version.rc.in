// VERSIONINFO of isshoni-media.dll (docs/m2/04-windows-engine.md section 13.4, docs/m2/06-windows-release.md section
// 5.1): native/windows/CMakeLists.txt configures this file from IM_VERSION (the release SemVer) and IM_WINVER (its
// four-part Windows form, tools/desktoppkg winver), and tools/desktoppkg dll-check verifies the result. SignPath
// needs this product metadata on every file it signs. ASCII only: rc.exe reads the file in the build's code page.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @IM_WINVER_COMMAS@
 PRODUCTVERSION @IM_WINVER_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "isshoni project"
            VALUE "FileDescription", "isshoni media engine"
            VALUE "FileVersion", "@IM_WINVER@"
            VALUE "InternalName", "isshoni-media"
            VALUE "LegalCopyright", "Copyright the isshoni authors. Apache-2.0."
            VALUE "OriginalFilename", "isshoni-media.dll"
            VALUE "ProductName", "isshoni"
            VALUE "ProductVersion", "@IM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
